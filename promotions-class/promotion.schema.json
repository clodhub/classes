{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "com.clodhub/promotion",
  "x-version": "1.0.0",
  "description": "A promotion as kept in the records collection promotions, in the form of a records export line's document: each date is {\"$date\": ISO 8601 text}.",
  "type": "object",
  "properties": {
    "_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "description": "Text by language code, such as {\"en\": ..., \"es\": ...}; any number of languages.",
      "minProperties": 1
    },
    "conditions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "description": "Text by language code, such as {\"en\": ..., \"es\": ...}; any number of languages."
    },
    "itemSlugs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "categorySlugs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "allItems": {
      "type": "boolean"
    },
    "packSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "discountPercent": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    },
    "active": {
      "type": "boolean"
    },
    "activateAt": {
      "oneOf": [
        {
          "$ref": "#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "deactivateAt": {
      "oneOf": [
        {
          "$ref": "#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "$ref": "#/$defs/date"
    },
    "updatedAt": {
      "$ref": "#/$defs/date"
    },
    "image": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "string",
              "description": "The image bytes in standard base64 with padding."
            },
            "mimeType": {
              "type": "string",
              "pattern": "^image/[a-z0-9-]+$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "description": "The decoded size, measured from data."
            }
          },
          "required": [
            "data",
            "mimeType",
            "bytes"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "_id",
    "title",
    "conditions",
    "itemSlugs",
    "categorySlugs",
    "allItems",
    "packSize",
    "discountPercent",
    "active",
    "activateAt",
    "deactivateAt",
    "createdAt",
    "updatedAt",
    "image"
  ],
  "additionalProperties": false,
  "$defs": {
    "date": {
      "type": "object",
      "properties": {
        "$date": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "$date"
      ],
      "additionalProperties": false
    }
  },
  "x-clodhub-modules": {}
}

  "components": {
    "schemas": {
      "WalletItemKind": {
        "enum": [
          "booking",
          "giftCard",
          "giftCardPurchase",
          "member"
        ],
        "description": "In this order. Swift WalletItemKind cases of the same names; Kotlin BOOKING, GIFT_CARD, GIFT_CARD_PURCHASE, MEMBER with these codes."
      },
      "WalletItem": {
        "type": "object",
        "description": "One thing the customer keeps (Swift struct WalletItem, Codable; Kotlin data class WalletItem with java.time.Instant). The wallet knows nothing of the server: snapshot is its last answer about the item, as JSON text.",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/WalletItemKind"
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "secret": {
            "type": "string",
            "description": "A booking's cancel token, a card's code; may be empty until known."
          },
          "snapshot": {
            "type": [
              "string",
              "null"
            ],
            "description": "JSON text; null before the first refresh."
          },
          "refreshedAt": {
            "oneOf": [
              {
                "type": "string",
                "format": "date-time",
                "description": "A JavaScript Date; shown here as its ISO 8601 text."
              },
              {
                "type": "null"
              }
            ],
            "description": "When the snapshot was answered; null before the first refresh."
          },
          "expiresAt": {
            "oneOf": [
              {
                "type": "string",
                "format": "date-time",
                "description": "A JavaScript Date; shown here as its ISO 8601 text."
              },
              {
                "type": "null"
              }
            ],
            "description": "When the item stops mattering (a booking's end, a card's expiry or last use); null keeps it."
          }
        },
        "required": [
          "kind",
          "id",
          "secret",
          "snapshot",
          "refreshedAt",
          "expiresAt"
        ],
        "additionalProperties": false
      },
      "KeyValueStorage": {
        "type": "object",
        "description": "localStorage or anything with the same three functions.",
        "required": [
          "getItem",
          "setItem",
          "removeItem"
        ],
        "properties": {
          "getItem": {
            "description": "Function (key) => string | null."
          },
          "setItem": {
            "description": "Function (key, value) => void."
          },
          "removeItem": {
            "description": "Function (key) => void."
          }
        }
      },
      "WalletOptions": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "default": "clodhub.customer-wallet",
            "description": "The storage key."
          },
          "keepDays": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3650,
            "default": 30,
            "description": "Days an expired item stays."
          },
          "now": {
            "description": "A function giving the current Date."
          }
        },
        "additionalProperties": false
      },
      "Wallet": {
        "type": "object",
        "description": "createWallet's object; its functions are the Wallet.* methods.",
        "required": [
          "items",
          "put",
          "remove",
          "prune",
          "clear",
          "subscribe"
        ]
      },
      "ImportResult": {
        "type": "object",
        "properties": {
          "imported": {
            "type": "integer",
            "minimum": 0
          },
          "rejected": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Lines that were not wallet-item records."
          }
        },
        "required": [
          "imported",
          "rejected"
        ],
        "additionalProperties": false
      }
    },
    "errors": {
      "InvalidItem": {
        "code": -32080,
        "message": "RangeError (Swift: precondition failure; Kotlin: IllegalArgumentException): an unknown kind, an empty id, a value of the wrong type or keepDays outside 0 to 3650 (programmer error)"
      },
      "StorageFailure": {
        "code": -32081,
        "message": "Swift KeychainWalletStorage.Failure with the Keychain's OSStatus; Kotlin IOException or GeneralSecurityException from the file or the Keystore"
      }
    }
  },
  "x-clodhub-modules": {
    "web": "web/index.ts",
    "apple": "apple/Sources",
    "android": "android/src/main/java"
  }
}

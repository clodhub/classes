{
  "openrpc": "1.3.2",
  "info": {
    "title": "com.clodhub/customer-wallet",
    "version": "1.0.0",
    "description": "The customer's bookings (with their cancel tokens), gift cards, gift card purchases and member codes kept on their device, each with its server's last answer about it, so the component knows nothing of the server: merge and prune written the same way in TypeScript, Swift and Kotlin (checked against one set of fixtures), kept in the Keychain on Apple devices, in a file sealed with an Android Keystore key on Android, and in the browser's storage on the website. The application refreshes the items from its server, and puts in the items a server gives back (to an app installed later), each with its snapshot."
  },
  "methods": [
    {
      "name": "merge",
      "description": "The items of both lists, one per kind and id, in kind order (booking, giftCard, giftCardPurchase, member) then id order (UTF-16 code units). Of two items with one kind and id the later refresh wins (no refresh is the earliest; a tie goes to the one later in the lists), but a secret is never replaced by an empty one. Swift WalletItems.merge(_:_:); Kotlin merge(current, incoming).",
      "paramStructure": "by-position",
      "params": [
        {
          "name": "current",
          "required": true,
          "schema": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WalletItem"
            }
          }
        },
        {
          "name": "incoming",
          "required": true,
          "schema": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WalletItem"
            }
          }
        }
      ],
      "result": {
        "name": "items",
        "schema": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/WalletItem"
          }
        }
      },
      "tags": [
        {
          "name": "typescript"
        },
        {
          "name": "swift"
        },
        {
          "name": "kotlin"
        }
      ],
      "errors": [
        {
          "$ref": "#/components/errors/InvalidItem"
        }
      ]
    },
    {
      "name": "prune",
      "description": "The items to keep, in their order: those with no expiry, or that expired at most keepDays before now. Swift WalletItems.prune(_:now:keepDays:); Kotlin prune(items, now, keepDays).",
      "paramStructure": "by-position",
      "params": [
        {
          "name": "items",
          "required": true,
          "schema": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WalletItem"
            }
          }
        },
        {
          "name": "now",
          "required": true,
          "schema": {
            "type": "string",
            "format": "date-time",
            "description": "A JavaScript Date; shown here as its ISO 8601 text."
          }
        },
        {
          "name": "keepDays",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3650
          }
        }
      ],
      "result": {
        "name": "items",
        "schema": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/WalletItem"
          }
        }
      },

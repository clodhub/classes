{
  "format": 3,
  "name": "pkg:clod/com.clodhub/web-host-class",
  "version": "1.1.0",
  "title": "Web host",
  "summary": "The web client's page, installable manifest, install banner and build",
  "category": "devices-and-hosts/web",
  "presentation": "visual",
  "provides": [
    {
      "type": "com.clodhub/web-shell",
      "version": "1.0.0",
      "path": "classes/web-host-class/web-shell.json",
      "modules": {
        "web": [
          "web/index.ts"
        ],
        "server": [
          "server/index.ts"
        ],
        "windows": [
          "web/index.ts"
        ]
      }
    }
  ],
  "requires": [
    {
      "type": "com.clodhub/theme",
      "version": "1.0.0"
    }
  ],
  "settings": {
    "type": "object",
    "properties": {
      "applicationId": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      },
      "applicationName": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9 -]{0,63}$"
      },
      "backgroundColour": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
      },
      "shortName": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9 -]{0,63}$"
      },
      "themeColour": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
      },
      "webAddress": {
        "type": "string",
        "pattern": "^https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9_/-]*)?$"
      }
    },
    "required": [
      "applicationId",
      "applicationName",
      "backgroundColour",
      "shortName",
      "themeColour",
      "webAddress"
    ],
    "additionalProperties": false
  },

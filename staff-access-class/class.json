  "format": 3,
  "name": "pkg:clod/com.clodhub/staff-access-class",
  "version": "1.0.0",
  "title": "Staff access",
  "summary": "PIN sign-in for a shop's admin and staff roles with signed sessions as cookies or bearer tokens, wrong PINs counted in a records store, closed whenever a PIN, the secret or the session is missing or wrong",
  "category": "people-and-accounts/permissions",
  "presentation": "none",

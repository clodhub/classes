        "type": "object",
        "description": "Texts in the customer's language, read after a day's date. Swift BookingCalendarLabels; Kotlin BookingCalendarLabels.",
        "properties": {
          "bookable": {
            "type": "string"
          },
          "closed": {
            "type": "string"
          },
          "byAppointment": {
            "type": "string"
          },
          "tooSoon": {
            "type": "string"
          },
          "tooShort": {
            "type": "string"
          },
          "booked": {
            "type": "string"
          },
          "previousMonth": {
            "type": "string"
          },

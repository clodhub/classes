    "errors": {
      "InvalidValue": {
        "code": -32090,
        "message": "RangeError (Swift: precondition failure; Kotlin: IllegalArgumentException): a month or date that is not a real one from 1900, a weekday outside 0 to 6, a count outside 1 to 36, a shift past 9999, columns outside 1 to 8 or an unknown day status (programmer error)"
      }
    }

          "booked": {
            "type": "boolean",
            "description": "The customer has a booking that day."
          },
          "selected": {
            "type": "boolean"
          },
          "selectable": {
            "type": "boolean",
            "description": "A bookable day or a booked one."
          }
        },
        "required": [
          "date",
          "day",
          "status",
          "booked",
          "selected",
          "selectable"
        ],
        "additionalProperties": false
      },

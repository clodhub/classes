  "components": {
    "schemas": {
      "DayStatus": {
        "enum": [
          "bookable",
          "closed",
          "by_appointment",
          "too_soon",
          "too_short"
        ],
        "description": "The day statuses the server gives. Swift BookingDayStatus (rawValue the code); Kotlin BookingDayStatus (code)."
      },
      "MonthGrid": {
        "type": "object",
        "description": "Swift BookingMonthGrid; Kotlin BookingMonthGrid.",
        "properties": {
          "month": {
            "type": "string",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
            "description": "YYYY-MM from 1900 on the business's clock."
          },
          "firstWeekday": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6,
            "description": "0 Sunday to 6 Saturday, as opening-hours numbers them."
          },
          "weekdays": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6,
              "description": "0 Sunday to 6 Saturday, as opening-hours numbers them."
            },
            "minItems": 7,
            "maxItems": 7,
            "description": "Each column's weekday."
          },
          "weeks": {
            "type": "array",
            "minItems": 4,
            "maxItems": 6,
            "items": {
              "type": "array",
              "minItems": 7,
              "maxItems": 7,
              "items": {
                "oneOf": [
                  {
                    "type": "string",
                    "format": "date",
                    "description": "YYYY-MM-DD from 1900 on the business's clock."
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "description": "Seven cells a week: a date, or null outside the month."
          }
        },
        "required": [
          "month",
          "firstWeekday",
          "weekdays",
          "weeks"
        ],
        "additionalProperties": false
      },
      "CalendarDay": {
        "type": "object",
        "description": "What one cell shows. Swift BookingCalendarDay; Kotlin BookingCalendarDay.",
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "description": "YYYY-MM-DD from 1900 on the business's clock."
          },
          "day": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31
          },
          "status": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/DayStatus"
              },
              {
                "type": "null"
              }

{
  "openrpc": "1.3.2",
  "info": {
    "title": "com.clodhub/booking-calendar",
    "version": "1.0.0",
    "description": "The booking calendar: the month with its open days, then the free times of a day, and the customer's own bookings by month. The month grid and the day states are written the same way in TypeScript, Swift and Kotlin (checked against one set of fixtures); the views are React (web and Windows), SwiftUI (iPhone, iPad, Mac and Apple TV, with focus) and Compose (Android), styled by the colours and corner the application passes in and read by VoiceOver and TalkBack with full dates. The application fills them from its server's answers."
  },
  "methods": [
    {
      "name": "monthGrid",
      "description": "The month's weeks starting on firstWeekday: leading and trailing cells outside the month are null; four to six weeks. Swift monthGrid(month:firstWeekday:); Kotlin monthGrid(month, firstWeekday).",
      "paramStructure": "by-position",
      "params": [
        {
          "name": "month",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
            "description": "YYYY-MM from 1900 on the business's clock."
          }
        },
        {
          "name": "firstWeekday",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6,
            "description": "0 Sunday to 6 Saturday, as opening-hours numbers them."
          }
        }
      ],
      "result": {
        "name": "grid",
        "schema": {
          "$ref": "#/components/schemas/MonthGrid"
        }
      },
      "tags": [
        {
